# ===========================================
# Frontend (Next.js) — опционально
# ===========================================
# URL вашего Strapi. По умолчанию в коде уже указан инстанс — меню, контакты
# и всё, что создано в админке Strapi, подтягиваются оттуда.
# Переопределите, если разворачиваете на другом сервере/домене.
#
# NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
# В режиме npm run dev по умолчанию уже используется http://127.0.0.1:1337
# NEXT_PUBLIC_STRAPI_URL=https://cms.example.com
#
# Автоперевод новостей (ru → be/en). Опционально.
# LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=your-key
#
# Логи Strapi-запросов в консоли (для отладки). По умолчанию выключены.
# STRAPI_DEBUG_LOGS=true
