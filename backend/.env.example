HOST=0.0.0.0
PORT=1337
# Публичный URL Strapi по домену (для админки и API за nginx). Без слеша в конце.
# Пример: https://api.devsu.site
STRAPI_PUBLIC_URL=
# Разрешённые origins для CORS (через запятую). Можно с https:// или просто домены.
# Для вашего прода:
CORS_ORIGINS=https://api.ogkjt.by,ogkjt.bsut.by,ogkjt.by
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Оптимизация изображений при upload:
# IMAGE_OPTIMIZER_FORMAT: webp или avif
IMAGE_OPTIMIZER_FORMAT=webp
# Макс. ширина в пикселях (без увеличения маленьких изображений)
IMAGE_OPTIMIZER_MAX_WIDTH=2560
# Качество для webp/avif (0-100)
IMAGE_OPTIMIZER_WEBP_QUALITY=78
IMAGE_OPTIMIZER_AVIF_QUALITY=52
# Не оптимизировать файлы меньше этого порога (в байтах)
IMAGE_OPTIMIZER_MIN_SOURCE_BYTES=120000
# Минимальный выигрыш в %, иначе оставляем оригинал
IMAGE_OPTIMIZER_MIN_SAVINGS_PERCENT=12
