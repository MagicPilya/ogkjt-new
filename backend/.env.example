HOST=0.0.0.0
PORT=1337
# Публичный URL Strapi по домену (для админки и API за nginx). Без слеша в конце.
# Пример: https://api.devsu.site
STRAPI_PUBLIC_URL=
# Разрешённые origins для CORS (через запятую). Пример: https://www.devsu.site,https://devsu.site
CORS_ORIGINS=
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
