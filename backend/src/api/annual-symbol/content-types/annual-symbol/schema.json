    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "pageUrl": {
      "type": "string",
      "default": "/year-theme",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
