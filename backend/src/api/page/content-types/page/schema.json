{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Страница",
    "description": "Одна страница сайта: привязана к пункту меню, заголовок подставляется из меню, контент и опционально лента новостей"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "pageUrl": {
      "type": "customField",
      "customField": "global::menu-link-select",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true },
        "content-manager": { "visible": false },
        "content-type-builder": { "visible": false }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "metaDescription": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "content": {
      "type": "blocks",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["files"],
      "pluginOptions": { "i18n": { "localized": true } },
      "description": "Вложения к странице (документы для скачивания)"
    },
    "articleFeedSection": {
      "type": "enumeration",
      "enum": ["Не показывать", "НОВОСТИ КОЛЛЕДЖА", "НОВОСТИ ОБЩЕЖИТИЯ", "О колледже", "Абитуриентам", "Обучающимся", "Воспитательная работа", "Одно окно", "Электронные обращения"],
      "description": "Показывать под контентом страницы блок «Новости»: выберите раздел (откуда брать статьи) или «Не показывать»",
      "pluginOptions": {
        "i18n": { "localized": true },
        "content-manager": { "visible": false },
        "content-type-builder": { "visible": false }
      }
    }
  }
}
