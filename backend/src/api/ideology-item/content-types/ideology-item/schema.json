{
  "kind": "collectionType",
  "collectionName": "ideology_items",
  "info": {
    "singularName": "ideology-item",
    "pluralName": "ideology-items",
    "displayName": "Воспитательная работа",
    "description": "Материалы раздела «Воспитательная работа» (/ideology)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": false } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "date": {
      "type": "date"
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["files"]
    }
  }
}
